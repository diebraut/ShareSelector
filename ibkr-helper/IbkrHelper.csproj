<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IbkrApiDll Condition="'$(IbkrApiDll)' == ''">$(TwsApiRoot)\source\CSharpClient\client\bin\Release\net8.0\CSharpAPI.dll</IbkrApiDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Reference Include="CSharpAPI">
      <HintPath>$(IbkrApiDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Google.Protobuf" Version="3.29.5" />
  </ItemGroup>
</Project>
